#!/usr/bin/env bash
# =============================================================================
# Pre-commit hook - Vitalys App
# Cadena de custodia obligatoria y secuencial: Formatter -> Linter -> Tests.
# Si un paso falla, el hook termina con código != 0 y Git ABORTA el commit:
# los cambios quedan en el staging area y no se crea ningún commit.
# Instalación (una vez por clon):  git config core.hooksPath hooks
# =============================================================================
set -u

PY="${PYTHON:-python3}"
OBJETIVOS="src/vitalys tests"
LOG_DIR="$(git rev-parse --git-dir)/hook-logs"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/pre-commit_$(date +%Y%m%d_%H%M%S).log"

log() { echo -e "$1" | tee -a "$LOG"; }

abortar() {
  log "\n✖ [$1] FALLÓ. Commit ABORTADO (exit code $2)."
  log "  Corregí los errores, volvé a hacer 'git add' y repetí el commit."
  log "  Log completo: $LOG"
  exit "$2"
}

paso() { # $1 = etiqueta, resto = comando
  local etiqueta="$1"; shift
  log "\n▶ $etiqueta\n  \$ $*"
  "$@" 2>&1 | tee -a "$LOG"
  local rc=${PIPESTATUS[0]}
  [ "$rc" -eq 0 ] || abortar "$etiqueta" "$rc"
  log "✔ $etiqueta OK"
}

log "=== PRE-COMMIT HOOK | $(date '+%Y-%m-%d %H:%M:%S') | rama: $(git rev-parse --abbrev-ref HEAD) ==="

# shellcheck disable=SC2086
paso "1/3 Formatter (Black)" "$PY" -m black --check --diff $OBJETIVOS
# shellcheck disable=SC2086
paso "2/3 Linter (Ruff)" "$PY" -m ruff check $OBJETIVOS
paso "3/3 Pruebas unitarias + cobertura (pytest)" \
  "$PY" -m pytest --cov --cov-branch --cov-report=term-missing --cov-fail-under=80

log "\n=== ✔ TODOS LOS CONTROLES EN VERDE: commit autorizado ==="
exit 0
